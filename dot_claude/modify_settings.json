{{- /* chezmoi:modify-template */ -}}
{{- /*
  Merges the settings below into the live ~/.claude/settings.json instead of
  replacing it, so changes Claude Code writes itself (/plugin, /model) survive
  `chezmoi apply`. Every top-level key below is owned and overwritten on apply,
  except three that other tools also write to:
    - enabledPlugins is merged per plugin, and env per variable: the values
      below win, other entries stay.
    - hooks is merged per command. In each event below, any hook running one
      of the commands below is replaced by the current entry here, which goes
      first; hooks other tools install (moshi-hook) stay after it, and events
      not listed here are left alone.
  Keys not listed here are left alone. Removing a key, plugin, variable or hook
  here does not remove it from machines that already have it, and neither does
  changing a hook's command: the old command is no longer recognized as ours.
  The chezmoi:modify-template marker above is what makes the live file
  available as .chezmoi.stdin; don't add a .tmpl suffix.

  jq does the merge because it keeps the live file's key order, which is the
  order Claude Code writes in; Go templates would sort every key and turn each
  apply into a whole-file diff. If no managed value differs, the live file
  passes through byte for byte. A missing file is written straight from the
  settings below. Without jq (Linux before brew installs it) an existing file
  passes through and the next apply merges. Keys below follow Claude Code's
  order so fresh files and rewrites match it too.
*/ -}}
{{- $notif := "auto" -}}
{{- if has .terminal (list "kitty" "iterm2") }}{{ $notif = .terminal }}{{ end -}}
{{- $managed := `
{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.bashrc)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-bash.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__HOME__/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); cwd=$(echo \"$cwd\" | sed \"s|^$HOME|~|\"); path_seg=$(printf \"\\033[1;36m%s\\033[0m\" \"$cwd\"); git_seg=\"\"; if git -C \"$cwd\" rev-parse --git-dir > /dev/null 2>&1; then branch=$(git -C \"$cwd\" -c core.useBuiltinFSMonitor=false rev-parse --abbrev-ref HEAD 2>/dev/null); git_status=$(git -C \"$cwd\" -c core.useBuiltinFSMonitor=false status --porcelain 2>/dev/null); if [ -n \"$git_status\" ]; then color=\"\\033[33m\"; else color=\"\\033[32m\"; fi; staged=$(echo \"$git_status\" | grep -c \"^[MADRCU]\" || echo 0); unstaged=$(echo \"$git_status\" | grep -c \"^.[MADRCU]\" || echo 0); status_str=\"\"; if [ \"$unstaged\" -gt 0 ]; then status_str=\" ~${unstaged}\"; fi; if [ \"$staged\" -gt 0 ]; then status_str=\"${status_str} +${staged}\"; fi; git_seg=$(printf \" %b%s%s\\033[0m\" \"$color\" \"$branch\" \"$status_str\"); fi; py_seg=\"\"; if [ -n \"$VIRTUAL_ENV\" ]; then venv=$(basename \"$VIRTUAL_ENV\"); pyver=$(python3 --version 2>&1 | awk '{print $2}'); py_seg=$(printf \" \\033[33m %s %s\\033[0m\" \"$venv\" \"$pyver\"); fi; echo \"${path_seg}${git_seg}${py_seg}\""
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "__NOTIF_CHANNEL__",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
` | replace "__HOME__" .chezmoi.homeDir | replace "__NOTIF_CHANNEL__" $notif | trim -}}
{{- if not (trim .chezmoi.stdin) -}}
{{ $managed }}
{{ else if lookPath "jq" -}}
{{-   $merged := output "jq" "-n" "--argjson" "cur" .chezmoi.stdin "--argjson" "m" $managed
        `[$m.hooks[][].hooks[].command] as $ours
        | $cur + $m
        | .env = (($cur.env // {}) + $m.env)
        | .enabledPlugins = (($cur.enabledPlugins // {}) + $m.enabledPlugins)
        | .hooks = reduce ($m.hooks | keys_unsorted[]) as $e ($cur.hooks // {};
            .[$e] = $m.hooks[$e] + [(.[$e] // [])[]
              | if (.hooks | type) == "array"
                then .hooks |= map(select(.command | IN($ours[]) | not))
                  | select(.hooks != [])
                else . end])` -}}
{{-   if eq (toJson (fromJson $merged)) (toJson (fromJson .chezmoi.stdin)) -}}
{{-     .chezmoi.stdin -}}
{{-   else -}}
{{-     $merged -}}
{{-   end -}}
{{- else -}}
{{-   .chezmoi.stdin -}}
{{- end -}}
