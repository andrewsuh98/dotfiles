{{- /* chezmoi:modify-template */ -}}
{{- /*
  Merges the settings below into the live ~/.claude/settings.json instead of
  replacing it, so changes Claude Code writes itself (/plugin, /model) survive
  `chezmoi apply`. Every top-level key below is owned and overwritten on apply,
  except enabledPlugins, which is merged per plugin. Keys not listed here are
  left alone. Removing a key or plugin here does not remove it from machines
  that already have it. The chezmoi:modify-template marker above is what makes
  the live file available as .chezmoi.stdin; don't add a .tmpl suffix.
*/ -}}
{{- $current := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $current = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $notif := "auto" -}}
{{- if eq .terminal "kitty" -}}
{{-   $notif = "kitty" -}}
{{- else if eq .terminal "iterm2" -}}
{{-   $notif = "iterm2" -}}
{{- end -}}
{{- $managed := `
{
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.bashrc)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-bash.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__HOME__/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); cwd=$(echo \"$cwd\" | sed \"s|^$HOME|~|\"); path_seg=$(printf \"\\033[1;36m%s\\033[0m\" \"$cwd\"); git_seg=\"\"; if git -C \"$cwd\" rev-parse --git-dir > /dev/null 2>&1; then branch=$(git -C \"$cwd\" -c core.useBuiltinFSMonitor=false rev-parse --abbrev-ref HEAD 2>/dev/null); git_status=$(git -C \"$cwd\" -c core.useBuiltinFSMonitor=false status --porcelain 2>/dev/null); if [ -n \"$git_status\" ]; then color=\"\\033[33m\"; else color=\"\\033[32m\"; fi; staged=$(echo \"$git_status\" | grep -c \"^[MADRCU]\" || echo 0); unstaged=$(echo \"$git_status\" | grep -c \"^.[MADRCU]\" || echo 0); status_str=\"\"; if [ \"$unstaged\" -gt 0 ]; then status_str=\" ~${unstaged}\"; fi; if [ \"$staged\" -gt 0 ]; then status_str=\"${status_str} +${staged}\"; fi; git_seg=$(printf \" %b%s%s\\033[0m\" \"$color\" \"$branch\" \"$status_str\"); fi; py_seg=\"\"; if [ -n \"$VIRTUAL_ENV\" ]; then venv=$(basename \"$VIRTUAL_ENV\"); pyver=$(python3 --version 2>&1 | awk '{print $2}'); py_seg=$(printf \" \\033[33m %s %s\\033[0m\" \"$venv\" \"$pyver\"); fi; echo \"${path_seg}${git_seg}${py_seg}\""
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "__NOTIF_CHANNEL__",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
` | replace "__HOME__" .chezmoi.homeDir | replace "__NOTIF_CHANNEL__" $notif | fromJson -}}
{{- range $key, $value := $managed -}}
{{-   if eq $key "enabledPlugins" -}}
{{-     $plugins := dict -}}
{{-     if hasKey $current "enabledPlugins" -}}
{{-       $plugins = index $current "enabledPlugins" -}}
{{-     end -}}
{{-     range $plugin, $enabled := $value -}}
{{-       $_ := set $plugins $plugin $enabled -}}
{{-     end -}}
{{-     $_ := set $current $key $plugins -}}
{{-   else -}}
{{-     $_ := set $current $key $value -}}
{{-   end -}}
{{- end -}}
{{ toPrettyJson $current }}
