{{ if eq .chezmoi.os "darwin" -}}
# Additions on top of yazi's default keymap.
# Defaults: https://github.com/sxyazi/yazi/blob/main/yazi-config/preset/keymap-default.toml

[mgr]
prepend_keymap = [
	# Hand off to Finder for drag-and-drop, AirDrop, etc.
	{ on = "R", run = "shell 'open -R %s'", desc = "Reveal in Finder" },
]
{{ end -}}
