{{- $name := promptStringOnce . "name" "Git full name" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}

{{/* Primary role. Prompted on macOS; anything else is a headless Linux server. */}}
{{- $role := "server" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $role = promptChoiceOnce . "role" "Machine role" (list "personal" "work" "vm") -}}
{{- end -}}

{{/*
  Machine settings, derived from $role. Each can be overridden per machine by
  adding a [data.overrides] table to ~/.config/chezmoi/chezmoi.toml, e.g.:

      [data.overrides]
      rice = false
      terminal = "iterm2"
      key_remapper = "hammerspoon"
*/}}
{{- $rice       := dig "overrides" "rice"       (or (eq $role "personal") (eq $role "work")) . -}}
{{- $cli_extras := dig "overrides" "cli_extras" true                                         . -}}

{{/* Karabiner is preferred; restricted Macs can opt into Hammerspoon. */}}
{{- $default_key_remapper := "none" -}}
{{- if and $rice (eq .chezmoi.os "darwin") -}}
{{-   $default_key_remapper = "karabiner" -}}
{{- end -}}
{{- $key_remapper := dig "overrides" "key_remapper" $default_key_remapper . -}}

{{/* Kitty is preferred on physical Macs; macOS VMs use iTerm2; servers use neither. */}}
{{- $default_terminal := "none" -}}
{{- if eq $role "vm" -}}
{{-   $default_terminal = "iterm2" -}}
{{- else if ne $role "server" -}}
{{-   $default_terminal = "kitty" -}}
{{- end -}}
{{- $terminal := dig "overrides" "terminal" $default_terminal . -}}

{{- $is_work     := eq $role "work" -}}
{{- $is_personal := eq $role "personal" -}}

{{/* Mac App Store apps are personal-only. */}}
{{- $install_mas := false -}}
{{- if $is_personal -}}
{{-   $install_mas = promptBoolOnce . "install_mas" "Install Mac App Store apps" -}}
{{- end -}}

[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  role = {{ $role | quote }}
  rice = {{ $rice | toToml }}
  cli_extras = {{ $cli_extras | toToml }}
  is_work = {{ $is_work | toToml }}
  is_personal = {{ $is_personal | toToml }}
  terminal = {{ $terminal | quote }}
  key_remapper = {{ $key_remapper | quote }}
  install_mas = {{ $install_mas | toToml }}
