{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Ensure brew is on PATH
eval "$(/opt/homebrew/bin/brew shellenv)"

# Trust third-party taps so brew bundle can install from them
brew trust jandedobbeleer/oh-my-posh
{{ if eq .install_profile "full" -}}
brew trust nikitabobko/tap
brew trust timrogers/tap
brew trust FelixKratz/formulae
{{ end -}}

brew bundle --file=/dev/stdin <<EOF
# -- Core Formulae (always installed) --
brew "bat"
brew "eza"
brew "fd"
brew "fzf"
brew "gh"
brew "ghostscript"
brew "git"
brew "git-lfs"
brew "lazygit"
brew "neovim"
brew "node"
brew "oh-my-posh"
brew "ripgrep"
brew "tmux"
brew "tpm"
brew "uv"
brew "yazi"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"

{{ if eq .install_profile "full" -}}
# -- Extra Formulae (full only) --
brew "btop"
brew "chafa"
brew "fastfetch"
brew "htop"
brew "nowplaying-cli"
brew "imagemagick"
tap "FelixKratz/formulae"
brew "sketchybar"
tap "timrogers/tap"  # for litra
brew "litra"  # control logi lighting
brew "mas"
brew "thefuck"
{{ end -}}

# -- Terminal Emulator --
{{ if .is_vm -}}
cask "iterm2"
{{ else -}}
cask "kitty"
{{ end -}}

{{ if eq .install_profile "full" -}}
# -- Casks (full only) --
cask "1password"
cask "adguard"
cask "arc"
cask "basictex"
cask "claude"
cask "claude-code"
cask "istat-menus"
cask "jordanbaird-ice@beta"
cask "karabiner-elements"
cask "keyboardcleantool"
cask "monitorcontrol"
cask "obsidian"
cask "raycast"
cask "slack"
cask "soundsource"
cask "nikitabobko/tap/aerospace"

{{ if .install_mas -}}
# -- Mac App Store --
mas "Fantastical", id: 975937182
mas "Spark", id: 1176895641
mas "Things", id: 904280696
{{ end -}}
{{ end -}}

EOF
{{ end -}}
