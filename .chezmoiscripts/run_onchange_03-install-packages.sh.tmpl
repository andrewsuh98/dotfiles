{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/bash
set -euo pipefail

# Ensure brew is on PATH (prefix differs by OS)
{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else -}}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ end -}}

# Trust third-party taps so brew bundle can install from them
brew trust jandedobbeleer/oh-my-posh
{{ if and .rice (eq .chezmoi.os "darwin") -}}
brew trust nikitabobko/tap
brew trust FelixKratz/formulae
{{ end -}}

# --no-upgrade: install missing packages only; don't upgrade existing ones on re-run
brew bundle --no-upgrade --file=/dev/stdin <<EOF
# -- Core formulae (all machines, all OSes) --
brew "bat"
brew "eza"
brew "fd"
brew "fzf"
brew "gh"
brew "ghostscript"
brew "git"
brew "git-lfs"
brew "lazygit"
brew "neovim"
brew "node"
brew "oh-my-posh"
brew "ripgrep"
brew "tmux"
brew "tpm"
brew "uv"
brew "yazi"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

{{ if .cli_extras -}}
# -- CLI extras --
brew "btop"
brew "chafa"
brew "fastfetch"
brew "htop"
brew "imagemagick"
brew "thefuck"
{{ end -}}
{{ if eq .chezmoi.os "darwin" }}
# -- Fonts used by terminals and SketchyBar --
cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"

{{ if .rice -}}
# -- Rice: window manager, status bar, borders, key remap (macOS) --
tap "FelixKratz/formulae"
brew "sketchybar"
brew "borders"  # JankyBorders — window border highlight, bootstrapped by aerospace
brew "nowplaying-cli"
cask "nikitabobko/tap/aerospace", args: { no_quarantine: true }  # not notarized; skip Gatekeeper quarantine (no sudo needed)
cask "karabiner-elements"
{{ end -}}

{{ if .gui -}}
# -- Terminal emulator --
{{ if eq .terminal "iterm2" -}}
cask "iterm2"
{{ else -}}
cask "kitty"
{{ end -}}
{{ end -}}

{{ if or .is_personal .is_work -}}
# -- Common GUI apps (personal + work) --
cask "1password"
cask "claude"
cask "claude-code@latest"  # self-updating cask; owns /opt/homebrew/bin/claude
cask "obsidian"
cask "raycast"
{{ end -}}

{{ if .is_personal -}}
# -- Personal apps --
cask "adguard"
cask "arc"
cask "basictex"
cask "istat-menus"
cask "jordanbaird-ice@beta"
cask "keyboardcleantool"
cask "monitorcontrol"
cask "soundsource"
brew "mas"

{{ if .install_mas -}}
# -- Mac App Store --
mas "Fantastical", id: 975937182
mas "Spark", id: 1176895641
mas "Things", id: 904280696
{{ end -}}
{{ end -}}
{{ end -}}
EOF
{{ end -}}
