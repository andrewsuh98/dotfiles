{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/bash
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
# Homebrew on Linux needs a compiler toolchain and a few base tools first.
if command -v apt-get &>/dev/null; then
  sudo apt-get update
  sudo apt-get install -y build-essential procps curl file git zsh
elif command -v dnf &>/dev/null; then
  sudo dnf groupinstall -y "Development Tools"
  sudo dnf install -y procps-ng curl file git zsh
fi

# Make zsh the login shell so .zshrc (and brew shellenv) load at login.
# sudo reuses the credentials cached by the package install above.
zsh_path="$(command -v zsh)"
user="$(id -un)"
if [ "$(getent passwd "$user" | cut -d: -f7)" != "$zsh_path" ]; then
  sudo chsh -s "$zsh_path" "$user"
fi
{{ end -}}

if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew (needs your password)..."
  # NONINTERACTIVE makes the installer use 'sudo -n', which fails unless
  # credentials are cached, so prompt for them once up front.
  sudo -v
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Add brew to PATH for subsequent scripts in this session
{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else -}}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ end -}}
{{ end -}}
